server {
    listen 0.0.0.0:{{ vless_agent_management_port }} ssl;
    server_name {{ vless_agent_domain }};

    ssl_certificate {{ vless_agent_tls_certificate_path }};
    ssl_certificate_key {{ vless_agent_tls_private_key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    server_tokens off;
    access_log off;
    error_log /var/log/nginx/vless-agent-error.log warn;
    client_max_body_size 2m;
    client_body_timeout 10s;
    keepalive_timeout 15s;
    send_timeout 15s;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control "no-store" always;

    location /api/v1/ {
        proxy_pass http://172.31.255.3:8000;
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass_request_headers on;
    }

    location / {
        return 404;
    }
}
