# Public node identity assigned by the central backend.
VLESS_NODE_ID=node-id-required
ENVIRONMENT_MODE=local
# Generate a unique token for every node; use at least 32 random characters.
AGENT_TOKEN_CURRENT=replace-with-a-unique-random-node-token
# Set only during rotation, then promote it to AGENT_TOKEN_CURRENT.
# AGENT_TOKEN_NEXT=replace-with-the-next-unique-random-node-token
