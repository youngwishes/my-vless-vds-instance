# Public node identity assigned by the central backend.
VLESS_NODE_ID=node-id-required
ENVIRONMENT_MODE=local
# Generate a unique token for every node; use at least 32 random characters.
AGENT_TOKEN_CURRENT=replace-with-a-unique-random-node-token
# Set only during rotation, then promote it to AGENT_TOKEN_CURRENT.
# AGENT_TOKEN_NEXT=replace-with-the-next-unique-random-node-token

# Exact build/runtime evidence returned by authenticated health. Xray values are
# fixed in production Compose and are shown here only for operator visibility.
AGENT_SHA=0000000000000000000000000000000000000000
XRAY_VERSION=26.7.11
XRAY_IMAGE_DIGEST=sha256:a1644183accdb0b5be967093fe34be756fd5de15fe2ee0206e842ae17350967f
XRAY_API_TARGET=xray:10085
XRAY_API_TIMEOUT_SECONDS=5
XRAY_MANAGED_INBOUND_TAG=vless-managed
SNAPSHOT_PATH=/var/lib/vless-agent/snapshot.json

# Generate with the pinned Xray binary (`xray x25519`). The file must contain
# only the private key, be owned by runtime uid/gid 65532:65532, and use mode
# 0400 or 0600. Keep it outside the repository; never commit or log its value.
REALITY_PRIVATE_KEY_FILE=/secure/runtime/secrets/reality_private_key
# Must be a hostname:port whose every DNS answer is public and whose TLS
# certificate accepts REALITY_SERVER_NAME over TLS 1.3.
REALITY_TARGET=origin.example:443
REALITY_SERVER_NAME=www.example.com
# One or more comma-separated, unique, even-length hexadecimal values (max 16).
REALITY_SHORT_IDS=0123456789abcdef
VLESS_PUBLIC_PORT=443
